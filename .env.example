# このファイルを .env という名前でコピーして使います。
#   cp .env.example .env
#
# 1) Gemini の無料 APIキー
#    https://aistudio.google.com/apikey で取得して貼り付ける。
GEMINI_API_KEY=ここにGeminiのAPIキーを貼る

# 2) RAGラボ専用 DB への接続文字列。
#    docker-compose.yml の rag-db（ポート5433）と一致させている。
RAG_DATABASE_URL=postgresql+psycopg2://raglab:raglab_dev_password@localhost:5433/raglab
